---
// Ambient, non-interactive knowledge graph confined to the hero section. Spans
// the full page width but only the hero's height, sits behind the hero content,
// drifts slowly, and is pulled toward the cursor. Never blocks clicks/selection.
---
<canvas id="network-bg" aria-hidden="true"></canvas>

<style>
  #network-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    display: block;
  }
</style>

<script>
  import { createSimulation } from '../lib/forceGraph';
  import { networkNodes, networkEdges } from '../data/network';

  const canvas = document.getElementById('network-bg') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const hero = canvas.parentElement as HTMLElement;
    const ACCENT = '#5eead4';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Bigger, more energetic tuning for a prominent hero element.
    const TUNING = {
      linkDistance: 130,
      linkStrength: 0.025,
      charge: 500,
      damping: 0.87,
      centerStrength: 0.002,
      wander: 0.07,
      pointerRadius: 320,
      pointerStrength: 0.5,
      minDistance: 16,
    };

    let width = 0;
    let height = 0;
    let sim: ReturnType<typeof createSimulation> | null = null;
    let started = false;
    let rafId = 0;
    let running = false;
    let startTime = 0;

    const pointer = { x: 0, y: 0, active: false };

    function sizeCanvas() {
      const rect = canvas!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.floor(width * dpr);
      canvas!.height = Math.floor(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // Lay clusters out left -> middle -> right so the graph reads as a network
    // spanning the full hero width; spread vertically across its height.
    function seedNodes() {
      return networkNodes.map((node) => {
        let bandMin: number;
        let bandMax: number;
        if (node.cluster === 0) {
          bandMin = 0.05;
          bandMax = 0.34;
        } else if (node.cluster === 2) {
          bandMin = 0.66;
          bandMax = 0.95;
        } else {
          bandMin = 0.36;
          bandMax = 0.64;
        }
        return {
          id: node.id,
          x: width * (bandMin + Math.random() * (bandMax - bandMin)),
          y: height * (0.08 + Math.random() * 0.84),
        };
      });
    }

    function draw() {
      if (!sim) return;
      ctx!.clearRect(0, 0, width, height);

      // Links.
      ctx!.strokeStyle = ACCENT;
      ctx!.lineWidth = 1;
      ctx!.globalAlpha = 0.12;
      ctx!.beginPath();
      for (const e of sim.edges) {
        const a = sim.nodes[e.source];
        const b = sim.nodes[e.target];
        ctx!.moveTo(a.x, a.y);
        ctx!.lineTo(b.x, b.y);
      }
      ctx!.stroke();

      // Nodes and labels.
      ctx!.fillStyle = ACCENT;
      ctx!.font = '13px "JetBrains Mono", ui-monospace, monospace';
      ctx!.textBaseline = 'middle';
      for (let i = 0; i < sim.nodes.length; i++) {
        const nd = sim.nodes[i];
        ctx!.globalAlpha = 0.32;
        ctx!.beginPath();
        ctx!.arc(nd.x, nd.y, 4, 0, Math.PI * 2);
        ctx!.fill();
        ctx!.globalAlpha = 0.22;
        ctx!.fillText(networkNodes[i].label, nd.x + 8, nd.y);
      }
      ctx!.globalAlpha = 1;
    }

    const frame = (now: number) => {
      if (startTime === 0) startTime = now;
      const t = (now - startTime) / 1000;
      sim!.step(pointer, t);
      draw();
      rafId = requestAnimationFrame(frame);
    };

    function play() {
      if (running || !sim || reduceMotion) return;
      running = true;
      startTime = 0;
      rafId = requestAnimationFrame(frame);
    }

    function pause() {
      running = false;
      cancelAnimationFrame(rafId);
    }

    function init() {
      sizeCanvas();
      if (width === 0 || height === 0) return; // wait for a real layout size
      sim = createSimulation(seedNodes(), networkEdges, { width, height, ...TUNING });
      started = true;

      if (reduceMotion) {
        sim.options.wander = 0;
        sim.options.pointerStrength = 0;
        for (let i = 0; i < 320; i++) sim.step(null, 0);
        draw();
        return;
      }

      play();
      hero.addEventListener('mousemove', (e) => {
        const rect = canvas!.getBoundingClientRect();
        pointer.x = e.clientX - rect.left;
        pointer.y = e.clientY - rect.top;
        pointer.active = true;
      });
      hero.addEventListener('mouseleave', () => {
        pointer.active = false;
      });
    }

    // Size to the hero box and react to layout changes (viewport width, font reflow).
    const ro = new ResizeObserver(() => {
      if (!started) {
        init();
        return;
      }
      const oldW = width;
      const oldH = height;
      sizeCanvas();
      if (oldW && oldH && sim && (width !== oldW || height !== oldH)) {
        const sx = width / oldW;
        const sy = height / oldH;
        for (const nd of sim.nodes) {
          nd.x *= sx;
          nd.y *= sy;
        }
        sim.options.width = width;
        sim.options.height = height;
        if (reduceMotion) draw();
      }
    });
    ro.observe(canvas);

    if (!reduceMotion) {
      // Only animate while the hero is on screen and the tab is visible.
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) pause();
        else play();
      });
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) play();
          else pause();
        }
      });
      io.observe(hero);
    }
  }
</script>
