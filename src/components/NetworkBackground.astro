---
// Ambient, non-interactive background: a faint force-directed knowledge graph
// that drifts slowly and is gently tugged by the cursor. Sits behind all
// content and never blocks clicks or text selection.
---
<canvas id="network-bg" aria-hidden="true"></canvas>

<style>
  #network-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    display: block;
  }
</style>

<script>
  import { createSimulation } from '../lib/forceGraph';
  import { networkNodes, networkEdges } from '../data/network';

  const canvas = document.getElementById('network-bg') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const ACCENT = '#5eead4';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = 0;
    let height = 0;

    function applyCanvasSize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas!.width = Math.floor(width * dpr);
      canvas!.height = Math.floor(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // Seed positions with a horizontal bias so labels land mostly in the side
    // margins, keeping the centred text column readable. Vertically spread out.
    function seedNodes() {
      return networkNodes.map((node) => {
        let bandMin: number;
        let bandMax: number;
        if (node.cluster === 0) {
          bandMin = 0.04;
          bandMax = 0.28;
        } else if (node.cluster === 2) {
          bandMin = 0.72;
          bandMax = 0.96;
        } else if (Math.random() < 0.5) {
          bandMin = 0.05;
          bandMax = 0.33;
        } else {
          bandMin = 0.67;
          bandMax = 0.95;
        }
        return {
          id: node.id,
          x: width * (bandMin + Math.random() * (bandMax - bandMin)),
          y: height * (0.08 + Math.random() * 0.84),
        };
      });
    }

    applyCanvasSize();
    const sim = createSimulation(seedNodes(), networkEdges, { width, height });

    const pointer = { x: 0, y: 0, active: false };

    function draw() {
      ctx!.clearRect(0, 0, width, height);

      // Links.
      ctx!.strokeStyle = ACCENT;
      ctx!.lineWidth = 1;
      ctx!.globalAlpha = 0.08;
      ctx!.beginPath();
      for (const e of sim.edges) {
        const a = sim.nodes[e.source];
        const b = sim.nodes[e.target];
        ctx!.moveTo(a.x, a.y);
        ctx!.lineTo(b.x, b.y);
      }
      ctx!.stroke();

      // Nodes and labels.
      ctx!.fillStyle = ACCENT;
      ctx!.font = '11px "JetBrains Mono", ui-monospace, monospace';
      ctx!.textBaseline = 'middle';
      const centerMin = width * 0.34;
      const centerMax = width * 0.66;
      for (let i = 0; i < sim.nodes.length; i++) {
        const nd = sim.nodes[i];
        ctx!.globalAlpha = 0.22;
        ctx!.beginPath();
        ctx!.arc(nd.x, nd.y, 2.5, 0, Math.PI * 2);
        ctx!.fill();
        // Only label nodes out in the margins.
        if (nd.x < centerMin || nd.x > centerMax) {
          ctx!.globalAlpha = 0.14;
          ctx!.fillText(networkNodes[i].label, nd.x + 6, nd.y);
        }
      }
      ctx!.globalAlpha = 1;
    }

    if (reduceMotion) {
      // No animation: settle to a stable layout and draw a single frame.
      sim.options.wander = 0;
      sim.options.pointerStrength = 0;
      for (let i = 0; i < 320; i++) sim.step(null, 0);
      draw();
    } else {
      let rafId = 0;
      let startTime = 0;

      const frame = (now: number) => {
        if (startTime === 0) startTime = now;
        const t = (now - startTime) / 1000;
        sim.step(pointer, t);
        draw();
        rafId = requestAnimationFrame(frame);
      };

      rafId = requestAnimationFrame(frame);

      window.addEventListener('mousemove', (e) => {
        pointer.x = e.clientX;
        pointer.y = e.clientY;
        pointer.active = true;
      });
      window.addEventListener('mouseout', (e) => {
        if (!e.relatedTarget) pointer.active = false;
      });

      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          const oldW = width;
          const oldH = height;
          applyCanvasSize();
          if (oldW && oldH) {
            const sx = width / oldW;
            const sy = height / oldH;
            for (const nd of sim.nodes) {
              nd.x *= sx;
              nd.y *= sy;
            }
          }
          sim.options.width = width;
          sim.options.height = height;
        }, 150);
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          cancelAnimationFrame(rafId);
        } else {
          startTime = 0;
          rafId = requestAnimationFrame(frame);
        }
      });
    }
  }
</script>
