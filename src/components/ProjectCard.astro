---
import type { Project } from '../data/projects';

interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="project">
  <h3>{project.title}</h3>
  <p class="keywords mono">{project.stack.join(' · ')}</p>
  <p class="summary">{project.summary}</p>
  {project.repo && (
    <a class="code-link mono" href={project.repo}>View code ↗</a>
  )}
</article>

<style>
  .project { max-width: 46rem; }
  h3 { color: var(--accent); font-size: 1.2rem; margin-bottom: 0.2rem; }
  .keywords { color: var(--text-muted); font-size: 0.78rem; letter-spacing: 0.02em; margin: 0 0 0.45rem; }
  .summary { color: var(--text); margin: 0 0 0.4rem; }
  .code-link { font-size: 0.85rem; }
</style>
