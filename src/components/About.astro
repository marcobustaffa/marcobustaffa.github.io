---
// About: concise identity line plus key achievements.
const highlights = [
  'MSc thesis at the UNSW AI Institute in Sydney: AnyLight, a multi-agent RL system for city-scale traffic-signal control.',
  'Shipped an LLM pipeline automating legal document work as an AI consultant.',
  'At Tec Systems Engineering: drove a monolith-to-microservices strategy and cut storage 70% via a Hadoop/Parquet migration.',
  'English: C1 (TOEFL iBT).',
];
---
<section id="about" class="about">
  <div class="container">
    <p class="section-label">// about</p>
    <p class="intro">
      AI Engineer and Data Scientist. BSc Computer Science (103/110) and MSc Data
      Science at the University of Padova.
    </p>
    <ul class="highlights">
      {highlights.map((h) => <li>{h}</li>)}
    </ul>
  </div>
</section>

<style>
  .about .intro { color: var(--text-muted); max-width: 40rem; }
  .about .highlights {
    margin: 1.25rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.6rem;
    color: var(--text);
    max-width: 42rem;
  }
  .about .highlights li::marker { color: var(--accent); }
</style>
