---
// About: education plus key achievements.
const education = [
  'Bachelor in Computer Science, University of Padova',
  'Master in Data Science, University of Padova',
  'Research practicum at the UNSW AI Institute, Sydney',
];
const highlights = [
  'AnyLight: a multi-agent RL system for city-scale traffic-signal control (MSc thesis).',
  'Built an LLM pipeline for legal document parsing and extraction as an AI consultant, reaching 92% accuracy with a Langfuse evaluation framework.',
  'At Tec Systems Engineering: a cloud-native migration strategy and a Hadoop/Parquet migration that cut storage 70%.',
  'English: C1 (TOEFL iBT).',
];
---
<section id="about" class="about">
  <div class="container">
    <p class="section-label">// about</p>
    <div class="group">
      <h3 class="mono">Education</h3>
      <ul class="list">
        {education.map((e) => <li>{e}</li>)}
      </ul>
    </div>
    <div class="group">
      <h3 class="mono">Highlights</h3>
      <ul class="list">
        {highlights.map((h) => <li>{h}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about .group { margin-bottom: 1.75rem; max-width: 42rem; }
  .about .group:last-child { margin-bottom: 0; }
  .about h3 {
    font-size: 0.8rem;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .about .list { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.5rem; color: var(--text); }
  .about .list li::marker { color: var(--accent); }
</style>
